{
  "name": "washing-machine-client",
  "version": "1.0.0",
  "description": "Frontend for washing machine booking system",
  "private": true,
  "dependencies": {
    "axios": "^1.6.2",
    "date-fns": "^2.30.0",
    "i18next": "^23.7.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^6.20.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "GENERATE_SOURCEMAP=false react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "preinstall": "npx npm-force-resolutions"
  },
  "resolutions": {
    "@babel/plugin-proposal-numeric-separator": "^7.23.0",
    "@babel/plugin-proposal-private-methods": "^7.23.0",
    "@babel/plugin-proposal-class-properties": "^7.23.0",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.23.0",
    "@babel/plugin-proposal-optional-chaining": "^7.23.0",
    "@babel/plugin-proposal-private-property-in-object": "^7.23.0",
    "source-map": "^0.8.0",
    "eslint": "^9.0.0",
    "@babel/helper-create-regexp-features-plugin": "^7.23.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "react-scripts": "5.0.1",
    "typescript": "^5.3.2",
    "npm-force-resolutions": "^0.0.10"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}